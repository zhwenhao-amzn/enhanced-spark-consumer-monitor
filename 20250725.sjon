              ],
              "type": "object",
              "$schema": "http://json-schema.org/draft-07/schema#"
            }
          }
        }
      },
      {
        "ToolSpecification": {
          "name": "amzn_mcp___pippin_list_artifacts",
          "description": "Lists all artifacts for a specific Pippin project",

        "ToolSpecification": {
          "name": "amzn_mcp___imr_costs_get_fleet_summary",
          "description": "Presents the internal costs (IMR) for a fleet or AWS account. Retrieves the information from the tool Cerberus and monthly statements api.",
          "input_schema": {

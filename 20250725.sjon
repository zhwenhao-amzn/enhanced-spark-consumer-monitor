            {
              "id": "tooluse_779eFLf5RmqZPIqcZ7FMBQ",
              "name": "fs_write",
              "orig_name": "fs_write",
              "args": {
                "summary": "Create unit tests for S3 checkpoint reader",
                "path": "/Users/zhwenhao/qchatlog/EnhancedSparkConsumerMonitor/test/test_s3_checkpoint_reader.py",
                "file_text": "\"\"\"\nUnit tests for S3 Checkpoint Reader module.\n\"\"\"\n\nimport unittest\nfrom unittest.mock import Mock, patch, MagicMock\nimport json\nimport sys\nimport os\n\n# Add plugins to path\nsys.path.append(os.path.join(os.path.dirname(__file__), '..', 'plugins'))\n\nfrom s3_checkpoint_reader import S3CheckpointReader\n\n\nclass TestS3CheckpointReader(unittest.TestCase):\n    \"\"\"Test cases for S3CheckpointReader class.\"\"\"\n    \n    def setUp(self):\n        \"\"\"Set up test fixtures.\"\"\"\n        self.reader = S3CheckpointReader(aws_region='us-east-1')\n    \n    def test_parse_s3_path_valid(self):\n        \"\"\"Test parsing valid S3 paths.\"\"\"\n        bucket, key = self.reader.parse_s3_path('s3://test-bucket/path/to/file')\n        self.assertEqual(bucket, 'test-bucket')\n        self.assertEqual(key, 'path/to/file')\n    \n    def test_parse_s3_path_invalid(self):\n        \"\"\"Test parsing invalid S3 paths.\"\"\"\n        with self.assertRaises(ValueError):\n            self.reader.parse_s3_path('invalid-path')\n        \n        with self.assertRaises(ValueError):\n            self.reader.parse_s3_path('s3://bucket-only')\n    \n    @patch('boto3.client')\n    def test_list_checkpoint_files_success(self, mock_boto_client):\n        \"\"\"Test successful listing of checkpoint files.\"\"\"\n        # Mock S3 response\n        mock_s3 = Mock()\n        mock_boto_client.return_value = mock_s3\n        mock_s3.list_objects_v2.return_value = {\n            'Contents': [\n                {'Key': 'checkpoints/0'},\n                {'Key': 'checkpoints/1'},\n                {'Key': 'checkpoints/2'},\n                {'Key': 'checkpoints/.crc'},  # Should be filtered out\n                {'Key': 'checkpoints/'}       # Should be filtered out\n            ]\n        }\n        \n        files = self.reader.list_checkpoint_files('s3://test-bucket/checkpoints/')\n        \n        expected_files = ['checkpoints/0', 'checkpoints/1', 'checkpoints/2']\n        self.assertEqual(files, expected_files)\n        mock_s3.list_objects_v2.assert_called_once_with(\n            Bucket='test-bucket',\n            Prefix='checkpoints/'\n        )\n    \n    @patch('boto3.client')\n    def test_list_checkpoint_files_empty(self, mock_boto_client):\n        \"\"\"Test listing checkpoint files when none exist.\"\"\"\n        mock_s3 = Mock()\n        mock_boto_client.return_value = mock_s3\n        mock_s3.list_objects_v2.return_value = {}  # No Contents key\n        \n        files = self.reader.list_checkpoint_files('s3://test-bucket/checkpoints/')\n        \n        self.assertEqual(files, [])\n    \n    @patch('boto3.client')\n    def test_read_checkpoint_file_success(self, mock_boto_client):\n        \"\"\"Test successful reading of checkpoint file.\"\"\"\n        mock_s3 = Mock()\n        mock_boto_client.return_value = mock_s3\n        \n        # Mock file content\n        test_content = \"test checkpoint content\"\n        mock_response = Mock()\n        mock_response.read.return_value = test_content.encode('utf-8')\n        mock_s3.get_object.return_value = {'Body': mock_response}\n        \n        content = self.reader.read_checkpoint_file('s3://test-bucket/checkpoints/', 'checkpoints/0')\n        \n        self.assertEqual(content, test_content)\n        mock_s3.get_object.assert_called_once_with(\n            Bucket='test-bucket',\n            Key='checkpoints/0'\n        )\n    \n    def test_parse_checkpoint_content_valid(self):\n        \"\"\"Test parsing valid checkpoint content.\"\"\"\n        # Sample checkpoint content based on your format\n        content = '''{\"batchWatermarkMs\":0,\"batchTimestampMs\":1752752310004,\"conf\":{\"spark.sql.streaming.stateStore.providerClass\":\"org.apache.spark.sql.execution.streaming.state.HDFSBackedStateStoreProvider\"}}\n{\"stockprice\":{\"2\":753422,\"1\":752778,\"0\":754863}}'''\n        \n        parsed = self.reader.parse_checkpoint_content(content)\n        \n        self.assertIn('metadata', parsed)\n        self.assertIn('offsets', parsed)\n        self.assertIn('batch_timestamp', parsed)\n        self.assertIn('batch_watermark', parsed)\n        \n        self.assertEqual(parsed['batch_timestamp'], 1752752310004)\n        self.assertEqual(parsed['batch_watermark'], 0)\n        self.assertEqual(parsed['offsets']['stockprice']['2'], 753422)\n    \n    def test_parse_checkpoint_content_invalid(self):\n        \"\"\"Test parsing invalid checkpoint content.\"\"\"\n        # Test with insufficient lines\n        with self.assertRaises(ValueError):\n            self.reader.parse_checkpoint_content('{\"single_line\": true}')\n        \n        # Test with invalid JSON\n        with self.assertRaises(json.JSONDecodeError):\n            self.reader.parse_checkpoint_content('invalid json\\n{\"valid\": true}')\n    \n    def test_extract_topic_offsets(self):\n        \"\"\"Test extracting topic offsets from checkpoint data.\"\"\"\n        checkpoint_data = {\n            'offsets': {\n                'stockprice': {'0': 100, '1': 200, '2': 300},\n                'userdata': {'0': 50, '1': 75}\n            }\n        }\n        \n        topic_offsets = self.reader.extract_topic_offsets(checkpoint_data)\n        \n        expected = {\n            'stockprice': {0: 100, 1: 200, 2: 300},\n            'userdata': {0: 50, 1: 75}\n        }\n        self.assertEqual(topic_offsets, expected)\n    \n    def test_extract_topic_offsets_missing_data(self):\n        \"\"\"Test extracting topic offsets when offset data is missing.\"\"\"\n        checkpoint_data = {'metadata': {}}\n        \n        with self.assertRaises(ValueError):\n            self.reader.extract_topic_offsets(checkpoint_data)\n    \n    @patch('boto3.client')\n    def test_get_latest_offsets_integration(self, mock_boto_client):\n        \"\"\"Test integration of getting latest offsets from multiple paths.\"\"\"\n        mock_s3 = Mock()\n        mock_boto_client.return_value = mock_s3\n        \n        # Mock list_objects_v2 response\n        mock_s3.list_objects_v2.return_value = {\n            'Contents': [\n                {'Key': 'checkpoints/0'},\n                {'Key': 'checkpoints/1'}\n            ]\n        }\n        \n        # Mock get_object response\n        checkpoint_content = '''{\"batchWatermarkMs\":0,\"batchTimestampMs\":1752752310004,\"conf\":{}}\n{\"stockprice\":{\"0\":100,\"1\":200}}'''\n        \n        mock_response = Mock()\n        mock_response.read.return_value = checkpoint_content.encode('utf-8')\n        mock_s3.get_object.return_value = {'Body': mock_response}\n        \n        s3_paths = ['s3://test-bucket/checkpoints/']\n        results = self.reader.get_latest_offsets(s3_paths)\n        \n        self.assertIn('s3://test-bucket/checkpoints/', results)\n        checkpoint_data = results['s3://test-bucket/checkpoints/']\n        self.assertIn('offsets', checkpoint_data)\n        self.assertEqual(checkpoint_data['offsets']['stockprice']['0'], 100)\n\n\nif __name__ == '__main__':\n    unittest.main()",

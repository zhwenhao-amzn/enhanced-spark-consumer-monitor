                  "type": "string",
                  "description": "Tag to add to the issue"
                }
              },
              "additionalProperties": false,
              "$schema": "http://json-schema.org/draft-07/schema#",
              "type": "object",
              "required": [
                "issueId",
                "tag"
              ]
            }
          }
        }
      },

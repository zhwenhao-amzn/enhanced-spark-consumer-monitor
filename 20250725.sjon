                "summary": "Create test data generators for checkpoint simulation",
                "path": "/Users/zhwenhao/qchatlog/EnhancedSparkConsumerMonitor/test/test_data_generator.py",
                "file_text": "\"\"\"\nTest data generators for checkpoint simulation.\n\nThis module provides utilities to generate realistic test data\nfor Spark streaming checkpoints and Kafka offset scenarios.\n\"\"\"\n\nimport json\nimport random\nimport time\nfrom datetime import datetime, timedelta\nfrom typing import Dict, List, Tuple, Any\nimport os\n\n\nclass CheckpointDataGenerator:\n    \"\"\"Generates realistic Spark streaming checkpoint data for testing.\"\"\"\n    \n    def __init__(self, base_timestamp: int = None):\n        \"\"\"\n        Initialize checkpoint data generator.\n        \n        Args:\n            base_timestamp: Base timestamp in milliseconds (defaults to current time)\n        \"\"\"\n        self.base_timestamp = base_timestamp or int(time.time() * 1000)\n        self.spark_configs = {\n            \"spark.sql.streaming.stateStore.providerClass\": \"org.apache.spark.sql.execution.streaming.state.HDFSBackedStateStoreProvider\",\n            \"spark.sql.streaming.join.stateFormatVersion\": \"2\",\n            \"spark.sql.streaming.stateStore.compression.codec\": \"lz4\",\n            \"spark.sql.streaming.stateStore.rocksdb.formatVersion\": \"5\",\n            \"spark.sql.streaming.statefulOperator.useStrictDistribution\": \"true\",\n            \"spark.sql.streaming.flatMapGroupsWithState.stateFormatVersion\": \"2\",\n            \"spark.sql.streaming.multipleWatermarkPolicy\": \"min\",\n            \"spark.sql.streaming.aggregation.stateFormatVersion\": \"2\",\n            \"spark.sql.shuffle.partitions\": \"200\"\n        }\n    \n    def generate_metadata(self, batch_id: int = 0, watermark_delay_ms: int = 0) -> Dict[str, Any]:\n        \"\"\"\n        Generate checkpoint metadata (first line of checkpoint file).\n        \n        Args:\n            batch_id: Batch ID for the checkpoint\n            watermark_delay_ms: Watermark delay in milliseconds\n            \n        Returns:\n            Dictionary containing checkpoint metadata\n        \"\"\"\n        timestamp = self.base_timestamp + (batch_id * 5000)  # 5 second intervals\n        \n        return {\n            \"batchWatermarkMs\": self.base_timestamp - watermark_delay_ms,\n            \"batchTimestampMs\": timestamp,\n            \"conf\": self.spark_configs.copy()\n        }\n    \n    def generate_topic_offsets(self, topics: List[str], partitions_per_topic: int = 3,\n                             base_offset: int = 1000, offset_increment: int = 100) -> Dict[str, Dict[str, int]]:\n        \"\"\"\n        Generate topic offset data (second line of checkpoint file).\n        \n        Args:\n            topics: List of topic names\n            partitions_per_topic: Number of partitions per topic\n            base_offset: Base offset value\n            offset_increment: Increment between partition offsets\n            \n        Returns:\n            Dictionary mapping topic -> partition -> offset\n        \"\"\"\n        topic_offsets = {}\n        \n        for topic in topics:\n            partitions = {}\n            for partition in range(partitions_per_topic):\n                # Add some randomness to make it realistic\n                offset = base_offset + (partition * offset_increment) + random.randint(0, 50)\n                partitions[str(partition)] = offset\n            \n            topic_offsets[topic] = partitions\n        \n        return topic_offsets\n    \n    def generate_checkpoint_content(self, topics: List[str], batch_id: int = 0,\n                                  partitions_per_topic: int = 3, base_offset: int = 1000) -> str:\n        \"\"\"\n        Generate complete checkpoint file content.\n        \n        Args:\n            topics: List of topic names\n            batch_id: Batch ID for the checkpoint\n            partitions_per_topic: Number of partitions per topic\n            base_offset: Base offset value\n            \n        Returns:\n            Checkpoint file content as string (two JSON lines)\n        \"\"\"\n        metadata = self.generate_metadata(batch_id)\n        offsets = self.generate_topic_offsets(topics, partitions_per_topic, base_offset)\n        \n        line1 = json.dumps(metadata, separators=(',', ':'))\n        line2 = json.dumps(offsets, separators=(',', ':'))\n        \n        return f\"{line1}\\n{line2}\"\n    \n    def generate_checkpoint_sequence(self, topics: List[str], num_checkpoints: int = 5,\n                                   partitions_per_topic: int = 3, base_offset: int = 1000) -> List[str]:\n        \"\"\"\n        Generate a sequence of checkpoint files showing progression.\n        \n        Args:\n            topics: List of topic names\n            num_checkpoints: Number of checkpoint files to generate\n            partitions_per_topic: Number of partitions per topic\n            base_offset: Base offset value\n            \n        Returns:\n            List of checkpoint file contents\n        \"\"\"\n        checkpoints = []\n        current_offset = base_offset\n        \n        for batch_id in range(num_checkpoints):\n            content = self.generate_checkpoint_content(\n                topics, batch_id, partitions_per_topic, current_offset\n            )\n            checkpoints.append(content)\n            \n            # Increment offsets for next checkpoint\n            current_offset += random.randint(50, 200)\n        \n        return checkpoints\n\n\nclass ScenarioDataGenerator:\n    \"\"\"Generates test data for specific scenarios.\"\"\"\n    \n    def __init__(self):\n        \"\"\"Initialize scenario data generator.\"\"\"\n        self.checkpoint_generator = CheckpointDataGenerator()\n    \n    def generate_sp1_sp2_scenario(self) -> Dict[str, Any]:\n        \"\"\"\n        Generate test data for the sp1/sp2 scenario.\n        \n        Returns:\n            Dictionary containing test data for both applications\n        \"\"\"\n        # Generate checkpoint data for sp1\n        sp1_checkpoints = self.checkpoint_generator.generate_checkpoint_sequence(\n            topics=['stockprice'],\n            num_checkpoints=3,\n            partitions_per_topic=3,\n            base_offset=750000\n        )\n        \n        # Generate checkpoint data for sp2 (different offsets)\n        sp2_checkpoints = self.checkpoint_generator.generate_checkpoint_sequence(\n            topics=['stockprice'],\n            num_checkpoints=3,\n            partitions_per_topic=3,\n            base_offset=850000\n        )\n        \n        return {\n            'sp1': {\n                'path': 's3://zhwenhaodatalake/checkpoints/sp1/stockprice/offsets/',\n                'consumer_group': 'sp1',\n                'checkpoints': sp1_checkpoints,\n                'latest_checkpoint': sp1_checkpoints[-1]\n            },\n            'sp2': {\n                'path': 's3://zhwenhaodatalake/checkpoints/sp2/stockprice/offsets/',\n                'consumer_group': 'sp2',\n                'checkpoints': sp2_checkpoints,\n                'latest_checkpoint': sp2_checkpoints[-1]\n            }\n        }\n    \n    def generate_multi_topic_scenario(self) -> Dict[str, Any]:\n        \"\"\"\n        Generate test data for multi-topic scenario.\n        \n        Returns:\n            Dictionary containing test data for multiple topics\n        \"\"\"\n        topics = ['stockprice', 'userdata', 'transactions']\n        \n        checkpoints = self.checkpoint_generator.generate_checkpoint_sequence(\n            topics=topics,\n            num_checkpoints=3,\n            partitions_per_topic=2,\n            base_offset=500000\n        )\n        \n        return {\n            'path': 's3://zhwenhaodatalake/checkpoints/multi-app/offsets/',\n            'topics': topics,\n            'consumer_groups': {\n                'stockprice': 'stock-consumer-group',\n                'userdata': 'user-consumer-group',\n                'transactions': 'transaction-consumer-group'\n            },\n            'checkpoints': checkpoints,\n            'latest_checkpoint': checkpoints[-1]\n        }\n    \n    def generate_airflow_variables_config(self, scenario: str) -> Dict[str, str]:\n        \"\"\"\n        Generate Airflow Variables configuration for a specific scenario.\n        \n        Args:\n            scenario: Scenario name ('sp1_sp2', 'multi_topic', 'single_app')\n            \n        Returns:\n            Dictionary of Airflow Variable key-value pairs\n        \"\"\"\n        base_config = {\n            'msk_broker_string': 'b-1.zhwenhaomsk.88je25.c5.kafka.us-east-1.amazonaws.com:9092,b-2.zhwenhaomsk.88je25.c5.kafka.us-east-1.amazonaws.com:9092',\n            'aws_region': 'us-east-1'\n        }\n        \n        if scenario == 'sp1_sp2':\n            sp1_sp2_data = self.generate_sp1_sp2_scenario()\n            base_config.update({\n                's3_checkpoint_paths': json.dumps([\n                    sp1_sp2_data['sp1']['path'],\n                    sp1_sp2_data['sp2']['path']\n                ]),\n                'kafka_topics': json.dumps(['stockprice']),\n                'checkpoint_consumer_group_mapping': json.dumps({\n                    sp1_sp2_data['sp1']['path']: sp1_sp2_data['sp1']['consumer_group'],\n                    sp1_sp2_data['sp2']['path']: sp1_sp2_data['sp2']['consumer_group']\n                })\n            })\n        \n        elif scenario == 'multi_topic':\n            multi_topic_data = self.generate_multi_topic_scenario()\n            base_config.update({\n                's3_checkpoint_paths': json.dumps([multi_topic_data['path']]),\n                'kafka_topics': json.dumps(multi_topic_data['topics']),\n                'kafka_consumer_group_mapping': json.dumps(multi_topic_data['consumer_groups'])\n            })\n        \n        elif scenario == 'single_app':\n            base_config.update({\n                's3_checkpoint_paths': json.dumps(['s3://zhwenhaodatalake/checkpoints/single-app/offsets/']),\n                'kafka_topics': json.dumps(['stockprice']),\n                'kafka_consumer_group': 'single-app-consumer-group'\n            })\n        \n        return base_config\n\n\nclass TestFileGenerator:\n    \"\"\"Generates test files for local testing.\"\"\"\n    \n    def __init__(self, output_dir: str = None):\n        \"\"\"\n        Initialize test file generator.\n        \n        Args:\n            output_dir: Directory to save test files (defaults to test/data/)\n        \"\"\"\n        self.output_dir = output_dir or os.path.join(os.path.dirname(__file__), 'data')\n        os.makedirs(self.output_dir, exist_ok=True)\n        \n        self.scenario_generator = ScenarioDataGenerator()\n    \n    def create_checkpoint_files(self, scenario: str) -> Dict[str, str]:\n        \"\"\"\n        Create checkpoint files for a specific scenario.\n        \n        Args:\n            scenario: Scenario name\n            \n        Returns:\n            Dictionary mapping file path to file content\n        \"\"\"\n        files_created = {}\n        \n        if scenario == 'sp1_sp2':\n            data = self.scenario_generator.generate_sp1_sp2_scenario()\n            \n            for app_name, app_data in data.items():\n                # Create directory structure\n                app_dir = os.path.join(self.output_dir, app_name)\n                os.makedirs(app_dir, exist_ok=True)\n                \n                # Create checkpoint files\n                for i, checkpoint_content in enumerate(app_data['checkpoints']):\n                    file_path = os.path.join(app_dir, str(i))\n                    with open(file_path, 'w') as f:\n                        f.write(checkpoint_content)\n                    files_created[file_path] = checkpoint_content\n        \n        return files_created\n    \n    def create_config_files(self, scenario: str) -> str:\n        \"\"\"\n        Create Airflow Variables configuration file.\n        \n        Args:\n            scenario: Scenario name\n            \n        Returns:\n            Path to created configuration file\n        \"\"\"\n        config = self.scenario_generator.generate_airflow_variables_config(scenario)\n        \n        config_file = os.path.join(self.output_dir, f'{scenario}_config.json')\n        with open(config_file, 'w') as f:\n            json.dump(config, f, indent=2)\n        \n        return config_file\n    \n    def create_test_script(self, scenario: str) -> str:\n        \"\"\"\n        Create a test script for a specific scenario.\n        \n        Args:\n            scenario: Scenario name\n            \n        Returns:\n            Path to created test script\n        \"\"\"\n        script_content = f'''#!/bin/bash\n# Test script for {scenario} scenario\n\necho \"Setting up {scenario} scenario test...\"\n\n# Set Airflow Variables\n'''\n        \n        config = self.scenario_generator.generate_airflow_variables_config(scenario)\n        \n        for key, value in config.items():\n            script_content += f'airflow variables set {key} \\'{value}\\'\\n'\n        \n        script_content += '''\necho \"Configuration complete!\"\necho \"You can now run the DAG to test the scenario.\"\n'''\n        \n        script_file = os.path.join(self.output_dir, f'setup_{scenario}.sh')\n        with open(script_file, 'w') as f:\n            f.write(script_content)\n        \n        # Make script executable\n        os.chmod(script_file, 0o755)\n        \n        return script_file\n\n\ndef main():\n    \"\"\"Main function to generate test data.\"\"\"\n    print(\"Generating test data...\")\n    \n    # Initialize generators\n    file_generator = TestFileGenerator()\n    \n    # Generate data for different scenarios\n    scenarios = ['sp1_sp2', 'multi_topic', 'single_app']\n    \n    for scenario in scenarios:\n        print(f\"\\nGenerating {scenario} scenario...\")\n        \n        # Create checkpoint files\n        if scenario == 'sp1_sp2':\n            files = file_generator.create_checkpoint_files(scenario)\n            print(f\"Created {len(files)} checkpoint files\")\n        \n        # Create configuration file\n        config_file = file_generator.create_config_files(scenario)\n        print(f\"Created config file: {config_file}\")\n        \n        # Create test script\n        script_file = file_generator.create_test_script(scenario)\n        print(f\"Created test script: {script_file}\")\n    \n    print(f\"\\nAll test data generated in: {file_generator.output_dir}\")\n    print(\"You can use these files for local testing and validation.\")\n\n\nif __name__ == '__main__':\n    main()",

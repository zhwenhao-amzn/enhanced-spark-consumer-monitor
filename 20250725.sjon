              "args": {
                "summary": "Create unit tests for Kafka offset committer",
                "path": "/Users/zhwenhao/qchatlog/EnhancedSparkConsumerMonitor/test/test_kafka_offset_committer.py",
                "file_text": "\"\"\"\nUnit tests for Kafka Offset Committer module.\n\"\"\"\n\nimport unittest\nfrom unittest.mock import Mock, patch, MagicMock\nimport sys\nimport os\n\n# Add plugins to path\nsys.path.append(os.path.join(os.path.dirname(__file__), '..', 'plugins'))\n\nfrom kafka_offset_committer import KafkaOffsetCommitter, MultiConsumerGroupKafkaCommitter\nfrom kafka import TopicPartition\nfrom kafka.errors import KafkaError, KafkaTimeoutError, NoBrokersAvailable\n\n\nclass TestKafkaOffsetCommitter(unittest.TestCase):\n    \"\"\"Test cases for KafkaOffsetCommitter class.\"\"\"\n    \n    def setUp(self):\n        \"\"\"Set up test fixtures.\"\"\"\n        self.bootstrap_servers = \"broker1:9092,broker2:9092\"\n        self.consumer_group = \"test-group\"\n    \n    @patch('kafka_offset_committer.KafkaConsumer')\n    def test_connect_success(self, mock_kafka_consumer):\n        \"\"\"Test successful connection to Kafka.\"\"\"\n        mock_consumer = Mock()\n        mock_kafka_consumer.return_value = mock_consumer\n        mock_consumer.list_consumer_groups.return_value = []\n        \n        committer = KafkaOffsetCommitter(self.bootstrap_servers, self.consumer_group)\n        result = committer.connect()\n        \n        self.assertTrue(result)\n        self.assertIsNotNone(committer.consumer)\n    \n    @patch('kafka_offset_committer.KafkaConsumer')\n    def test_connect_no_brokers(self, mock_kafka_consumer):\n        \"\"\"Test connection failure when no brokers available.\"\"\"\n        mock_kafka_consumer.side_effect = NoBrokersAvailable()\n        \n        committer = KafkaOffsetCommitter(self.bootstrap_servers, self.consumer_group)\n        result = committer.connect()\n        \n        self.assertFalse(result)\n        self.assertIsNone(committer.consumer)\n    \n    @patch('kafka_offset_committer.KafkaConsumer')\n    def test_validate_topics(self, mock_kafka_consumer):\n        \"\"\"Test topic validation.\"\"\"\n        mock_consumer = Mock()\n        mock_kafka_consumer.return_value = mock_consumer\n        mock_consumer.topics.return_value = {'stockprice', 'userdata', 'transactions'}\n        \n        committer = KafkaOffsetCommitter(self.bootstrap_servers, self.consumer_group)\n        committer.consumer = mock_consumer\n        \n        topics_to_validate = ['stockprice', 'nonexistent']\n        result = committer.validate_topics(topics_to_validate)\n        \n        expected = {'stockprice': True, 'nonexistent': False}\n        self.assertEqual(result, expected)\n    \n    @patch('kafka_offset_committer.KafkaConsumer')\n    def test_get_topic_partitions(self, mock_kafka_consumer):\n        \"\"\"Test getting topic partitions.\"\"\"\n        mock_consumer = Mock()\n        mock_kafka_consumer.return_value = mock_consumer\n        mock_consumer.partitions_for_topic.return_value = {0, 1, 2}\n        \n        committer = KafkaOffsetCommitter(self.bootstrap_servers, self.consumer_group)\n        committer.consumer = mock_consumer\n        \n        partitions = committer.get_topic_partitions('stockprice')\n        \n        self.assertEqual(partitions, [0, 1, 2])\n    \n    @patch('kafka_offset_committer.KafkaConsumer')\n    def test_commit_offsets_success(self, mock_kafka_consumer):\n        \"\"\"Test successful offset commit.\"\"\"\n        mock_consumer = Mock()\n        mock_kafka_consumer.return_value = mock_consumer\n        mock_consumer.topics.return_value = {'stockprice'}\n        mock_consumer.commit.return_value = None\n        \n        committer = KafkaOffsetCommitter(self.bootstrap_servers, self.consumer_group)\n        committer.consumer = mock_consumer\n        \n        topic_offsets = {\n            'stockprice': {0: 100, 1: 200, 2: 300}\n        }\n        \n        result = committer.commit_offsets(topic_offsets)\n        \n        self.assertEqual(result, {'stockprice': True})\n        mock_consumer.assign.assert_called_once()\n        mock_consumer.commit.assert_called_once()\n    \n    @patch('kafka_offset_committer.KafkaConsumer')\n    def test_commit_offsets_timeout(self, mock_kafka_consumer):\n        \"\"\"Test offset commit timeout.\"\"\"\n        mock_consumer = Mock()\n        mock_kafka_consumer.return_value = mock_consumer\n        mock_consumer.topics.return_value = {'stockprice'}\n        mock_consumer.commit.side_effect = KafkaTimeoutError()\n        \n        committer = KafkaOffsetCommitter(self.bootstrap_servers, self.consumer_group)\n        committer.consumer = mock_consumer\n        \n        topic_offsets = {'stockprice': {0: 100}}\n        result = committer.commit_offsets(topic_offsets)\n        \n        self.assertEqual(result, {'stockprice': False})\n    \n    @patch('kafka_offset_committer.KafkaConsumer')\n    def test_get_current_offsets(self, mock_kafka_consumer):\n        \"\"\"Test getting current committed offsets.\"\"\"\n        mock_consumer = Mock()\n        mock_kafka_consumer.return_value = mock_consumer\n        mock_consumer.partitions_for_topic.return_value = {0, 1}\n        \n        # Mock committed offsets\n        tp0 = TopicPartition('stockprice', 0)\n        tp1 = TopicPartition('stockprice', 1)\n        mock_consumer.committed.return_value = {tp0: 101, tp1: 201}\n        \n        committer = KafkaOffsetCommitter(self.bootstrap_servers, self.consumer_group)\n        committer.consumer = mock_consumer\n        \n        result = committer.get_current_offsets(['stockprice'])\n        \n        expected = {'stockprice': {0: 100, 1: 200}}  # Subtract 1 from committed offset\n        self.assertEqual(result, expected)\n\n\nclass TestMultiConsumerGroupKafkaCommitter(unittest.TestCase):\n    \"\"\"Test cases for MultiConsumerGroupKafkaCommitter class.\"\"\"\n    \n    def setUp(self):\n        \"\"\"Set up test fixtures.\"\"\"\n        self.bootstrap_servers = \"broker1:9092,broker2:9092\"\n        self.consumer_group_mapping = {\n            'stockprice': 'group1',\n            'userdata': 'group2'\n        }\n    \n    def test_initialization(self):\n        \"\"\"Test multi-consumer group committer initialization.\"\"\"\n        committer = MultiConsumerGroupKafkaCommitter(\n            self.bootstrap_servers, \n            self.consumer_group_mapping\n        )\n        \n        self.assertEqual(committer.bootstrap_servers, self.bootstrap_servers)\n        self.assertEqual(committer.consumer_group_mapping, self.consumer_group_mapping)\n        \n        expected_group_topics = {\n            'group1': ['stockprice'],\n            'group2': ['userdata']\n        }\n        self.assertEqual(committer.group_topics, expected_group_topics)\n    \n    @patch('kafka_offset_committer.KafkaOffsetCommitter')\n    def test_connect_all_success(self, mock_committer_class):\n        \"\"\"Test connecting all consumer groups successfully.\"\"\"\n        # Mock successful connections\n        mock_committer1 = Mock()\n        mock_committer2 = Mock()\n        mock_committer1.connect.return_value = True\n        mock_committer2.connect.return_value = True\n        \n        mock_committer_class.side_effect = [mock_committer1, mock_committer2]\n        \n        committer = MultiConsumerGroupKafkaCommitter(\n            self.bootstrap_servers, \n            self.consumer_group_mapping\n        )\n        \n        result = committer.connect_all()\n        \n        expected = {'group1': True, 'group2': True}\n        self.assertEqual(result, expected)\n        self.assertEqual(len(committer.committers), 2)\n    \n    @patch('kafka_offset_committer.KafkaOffsetCommitter')\n    def test_connect_all_partial_failure(self, mock_committer_class):\n        \"\"\"Test connecting with some consumer groups failing.\"\"\"\n        mock_committer1 = Mock()\n        mock_committer2 = Mock()\n        mock_committer1.connect.return_value = True\n        mock_committer2.connect.return_value = False\n        \n        mock_committer_class.side_effect = [mock_committer1, mock_committer2]\n        \n        committer = MultiConsumerGroupKafkaCommitter(\n            self.bootstrap_servers, \n            self.consumer_group_mapping\n        )\n        \n        result = committer.connect_all()\n        \n        expected = {'group1': True, 'group2': False}\n        self.assertEqual(result, expected)\n        self.assertEqual(len(committer.committers), 1)  # Only successful connection stored\n    \n    @patch('kafka_offset_committer.KafkaOffsetCommitter')\n    def test_commit_offsets_multiple_groups(self, mock_committer_class):\n        \"\"\"Test committing offsets across multiple consumer groups.\"\"\"\n        # Setup mock committers\n        mock_committer1 = Mock()\n        mock_committer2 = Mock()\n        mock_committer1.connect.return_value = True\n        mock_committer2.connect.return_value = True\n        mock_committer1.commit_offsets.return_value = {'stockprice': True}\n        mock_committer2.commit_offsets.return_value = {'userdata': True}\n        \n        mock_committer_class.side_effect = [mock_committer1, mock_committer2]\n        \n        committer = MultiConsumerGroupKafkaCommitter(\n            self.bootstrap_servers, \n            self.consumer_group_mapping\n        )\n        committer.connect_all()\n        \n        topic_offsets = {\n            'stockprice': {0: 100, 1: 200},\n            'userdata': {0: 50}\n        }\n        \n        result = committer.commit_offsets(topic_offsets)\n        \n        expected = {\n            'group1': {'stockprice': True},\n            'group2': {'userdata': True}\n        }\n        self.assertEqual(result, expected)\n        \n        # Verify correct offsets were passed to each committer\n        mock_committer1.commit_offsets.assert_called_once_with({'stockprice': {0: 100, 1: 200}})\n        mock_committer2.commit_offsets.assert_called_once_with({'userdata': {0: 50}})\n    \n    @patch('kafka_offset_committer.KafkaOffsetCommitter')\n    def test_get_current_offsets_multiple_groups(self, mock_committer_class):\n        \"\"\"Test getting current offsets from multiple consumer groups.\"\"\"\n        mock_committer1 = Mock()\n        mock_committer2 = Mock()\n        mock_committer1.connect.return_value = True\n        mock_committer2.connect.return_value = True\n        mock_committer1.get_current_offsets.return_value = {'stockprice': {0: 99, 1: 199}}\n        mock_committer2.get_current_offsets.return_value = {'userdata': {0: 49}}\n        \n        mock_committer_class.side_effect = [mock_committer1, mock_committer2]\n        \n        committer = MultiConsumerGroupKafkaCommitter(\n            self.bootstrap_servers, \n            self.consumer_group_mapping\n        )\n        committer.connect_all()\n        \n        result = committer.get_current_offsets(['stockprice', 'userdata'])\n        \n        expected = {\n            'group1': {'stockprice': {0: 99, 1: 199}},\n            'group2': {'userdata': {0: 49}}\n        }\n        self.assertEqual(result, expected)\n    \n    def test_context_manager(self):\n        \"\"\"Test context manager functionality.\"\"\"\n        with patch('kafka_offset_committer.KafkaOffsetCommitter') as mock_committer_class:\n            mock_committer = Mock()\n            mock_committer.connect.return_value = True\n            mock_committer_class.return_value = mock_committer\n            \n            # Test successful context manager usage\n            with MultiConsumerGroupKafkaCommitter(self.bootstrap_servers, self.consumer_group_mapping) as committer:\n                self.assertIsNotNone(committer)\n            \n            # Verify disconnect was called\n            mock_committer.disconnect.assert_called()\n    \n    def test_context_manager_connection_failure(self):\n        \"\"\"Test context manager with connection failure.\"\"\"\n        with patch('kafka_offset_committer.KafkaOffsetCommitter') as mock_committer_class:\n            mock_committer = Mock()\n            mock_committer.connect.return_value = False\n            mock_committer_class.return_value = mock_committer\n            \n            # Test connection failure raises RuntimeError\n            with self.assertRaises(RuntimeError):\n                with MultiConsumerGroupKafkaCommitter(self.bootstrap_servers, self.consumer_group_mapping):\n                    pass\n\n\nif __name__ == '__main__':\n    unittest.main()",
                "command": "create"
              },
              "orig_args": {
                "summary": "Create unit tests for Kafka offset committer",
                "path": "/Users/zhwenhao/qchatlog/EnhancedSparkConsumerMonitor/test/test_kafka_offset_committer.py",
                "file_text": "\"\"\"\nUnit tests for Kafka Offset Committer module.\n\"\"\"\n\nimport unittest\nfrom unittest.mock import Mock, patch, MagicMock\nimport sys\nimport os\n\n# Add plugins to path\nsys.path.append(os.path.join(os.path.dirname(__file__), '..', 'plugins'))\n\nfrom kafka_offset_committer import KafkaOffsetCommitter, MultiConsumerGroupKafkaCommitter\nfrom kafka import TopicPartition\nfrom kafka.errors import KafkaError, KafkaTimeoutError, NoBrokersAvailable\n\n\nclass TestKafkaOffsetCommitter(unittest.TestCase):\n    \"\"\"Test cases for KafkaOffsetCommitter class.\"\"\"\n    \n    def setUp(self):\n        \"\"\"Set up test fixtures.\"\"\"\n        self.bootstrap_servers = \"broker1:9092,broker2:9092\"\n        self.consumer_group = \"test-group\"\n    \n    @patch('kafka_offset_committer.KafkaConsumer')\n    def test_connect_success(self, mock_kafka_consumer):\n        \"\"\"Test successful connection to Kafka.\"\"\"\n        mock_consumer = Mock()\n        mock_kafka_consumer.return_value = mock_consumer\n        mock_consumer.list_consumer_groups.return_value = []\n        \n        committer = KafkaOffsetCommitter(self.bootstrap_servers, self.consumer_group)\n        result = committer.connect()\n        \n        self.assertTrue(result)\n        self.assertIsNotNone(committer.consumer)\n    \n    @patch('kafka_offset_committer.KafkaConsumer')\n    def test_connect_no_brokers(self, mock_kafka_consumer):\n        \"\"\"Test connection failure when no brokers available.\"\"\"\n        mock_kafka_consumer.side_effect = NoBrokersAvailable()\n        \n        committer = KafkaOffsetCommitter(self.bootstrap_servers, self.consumer_group)\n        result = committer.connect()\n        \n        self.assertFalse(result)\n        self.assertIsNone(committer.consumer)\n    \n    @patch('kafka_offset_committer.KafkaConsumer')\n    def test_validate_topics(self, mock_kafka_consumer):\n        \"\"\"Test topic validation.\"\"\"\n        mock_consumer = Mock()\n        mock_kafka_consumer.return_value = mock_consumer\n        mock_consumer.topics.return_value = {'stockprice', 'userdata', 'transactions'}\n        \n        committer = KafkaOffsetCommitter(self.bootstrap_servers, self.consumer_group)\n        committer.consumer = mock_consumer\n        \n        topics_to_validate = ['stockprice', 'nonexistent']\n        result = committer.validate_topics(topics_to_validate)\n        \n        expected = {'stockprice': True, 'nonexistent': False}\n        self.assertEqual(result, expected)\n    \n    @patch('kafka_offset_committer.KafkaConsumer')\n    def test_get_topic_partitions(self, mock_kafka_consumer):\n        \"\"\"Test getting topic partitions.\"\"\"\n        mock_consumer = Mock()\n        mock_kafka_consumer.return_value = mock_consumer\n        mock_consumer.partitions_for_topic.return_value = {0, 1, 2}\n        \n        committer = KafkaOffsetCommitter(self.bootstrap_servers, self.consumer_group)\n        committer.consumer = mock_consumer\n        \n        partitions = committer.get_topic_partitions('stockprice')\n        \n        self.assertEqual(partitions, [0, 1, 2])\n    \n    @patch('kafka_offset_committer.KafkaConsumer')\n    def test_commit_offsets_success(self, mock_kafka_consumer):\n        \"\"\"Test successful offset commit.\"\"\"\n        mock_consumer = Mock()\n        mock_kafka_consumer.return_value = mock_consumer\n        mock_consumer.topics.return_value = {'stockprice'}\n        mock_consumer.commit.return_value = None\n        \n        committer = KafkaOffsetCommitter(self.bootstrap_servers, self.consumer_group)\n        committer.consumer = mock_consumer\n        \n        topic_offsets = {\n            'stockprice': {0: 100, 1: 200, 2: 300}\n        }\n        \n        result = committer.commit_offsets(topic_offsets)\n        \n        self.assertEqual(result, {'stockprice': True})\n        mock_consumer.assign.assert_called_once()\n        mock_consumer.commit.assert_called_once()\n    \n    @patch('kafka_offset_committer.KafkaConsumer')\n    def test_commit_offsets_timeout(self, mock_kafka_consumer):\n        \"\"\"Test offset commit timeout.\"\"\"\n        mock_consumer = Mock()\n        mock_kafka_consumer.return_value = mock_consumer\n        mock_consumer.topics.return_value = {'stockprice'}\n        mock_consumer.commit.side_effect = KafkaTimeoutError()\n        \n        committer = KafkaOffsetCommitter(self.bootstrap_servers, self.consumer_group)\n        committer.consumer = mock_consumer\n        \n        topic_offsets = {'stockprice': {0: 100}}\n        result = committer.commit_offsets(topic_offsets)\n        \n        self.assertEqual(result, {'stockprice': False})\n    \n    @patch('kafka_offset_committer.KafkaConsumer')\n    def test_get_current_offsets(self, mock_kafka_consumer):\n        \"\"\"Test getting current committed offsets.\"\"\"\n        mock_consumer = Mock()\n        mock_kafka_consumer.return_value = mock_consumer\n        mock_consumer.partitions_for_topic.return_value = {0, 1}\n        \n        # Mock committed offsets\n        tp0 = TopicPartition('stockprice', 0)\n        tp1 = TopicPartition('stockprice', 1)\n        mock_consumer.committed.return_value = {tp0: 101, tp1: 201}\n        \n        committer = KafkaOffsetCommitter(self.bootstrap_servers, self.consumer_group)\n        committer.consumer = mock_consumer\n        \n        result = committer.get_current_offsets(['stockprice'])\n        \n        expected = {'stockprice': {0: 100, 1: 200}}  # Subtract 1 from committed offset\n        self.assertEqual(result, expected)\n\n\nclass TestMultiConsumerGroupKafkaCommitter(unittest.TestCase):\n    \"\"\"Test cases for MultiConsumerGroupKafkaCommitter class.\"\"\"\n    \n    def setUp(self):\n        \"\"\"Set up test fixtures.\"\"\"\n        self.bootstrap_servers = \"broker1:9092,broker2:9092\"\n        self.consumer_group_mapping = {\n            'stockprice': 'group1',\n            'userdata': 'group2'\n        }\n    \n    def test_initialization(self):\n        \"\"\"Test multi-consumer group committer initialization.\"\"\"\n        committer = MultiConsumerGroupKafkaCommitter(\n            self.bootstrap_servers, \n            self.consumer_group_mapping\n        )\n        \n        self.assertEqual(committer.bootstrap_servers, self.bootstrap_servers)\n        self.assertEqual(committer.consumer_group_mapping, self.consumer_group_mapping)\n        \n        expected_group_topics = {\n            'group1': ['stockprice'],\n            'group2': ['userdata']\n        }\n        self.assertEqual(committer.group_topics, expected_group_topics)\n    \n    @patch('kafka_offset_committer.KafkaOffsetCommitter')\n    def test_connect_all_success(self, mock_committer_class):\n        \"\"\"Test connecting all consumer groups successfully.\"\"\"\n        # Mock successful connections\n        mock_committer1 = Mock()\n        mock_committer2 = Mock()\n        mock_committer1.connect.return_value = True\n        mock_committer2.connect.return_value = True\n        \n        mock_committer_class.side_effect = [mock_committer1, mock_committer2]\n        \n        committer = MultiConsumerGroupKafkaCommitter(\n            self.bootstrap_servers, \n            self.consumer_group_mapping\n        )\n        \n        result = committer.connect_all()\n        \n        expected = {'group1': True, 'group2': True}\n        self.assertEqual(result, expected)\n        self.assertEqual(len(committer.committers), 2)\n    \n    @patch('kafka_offset_committer.KafkaOffsetCommitter')\n    def test_connect_all_partial_failure(self, mock_committer_class):\n        \"\"\"Test connecting with some consumer groups failing.\"\"\"\n        mock_committer1 = Mock()\n        mock_committer2 = Mock()\n        mock_committer1.connect.return_value = True\n        mock_committer2.connect.return_value = False\n        \n        mock_committer_class.side_effect = [mock_committer1, mock_committer2]\n        \n        committer = MultiConsumerGroupKafkaCommitter(\n            self.bootstrap_servers, \n            self.consumer_group_mapping\n        )\n        \n        result = committer.connect_all()\n        \n        expected = {'group1': True, 'group2': False}\n        self.assertEqual(result, expected)\n        self.assertEqual(len(committer.committers), 1)  # Only successful connection stored\n    \n    @patch('kafka_offset_committer.KafkaOffsetCommitter')\n    def test_commit_offsets_multiple_groups(self, mock_committer_class):\n        \"\"\"Test committing offsets across multiple consumer groups.\"\"\"\n        # Setup mock committers\n        mock_committer1 = Mock()\n        mock_committer2 = Mock()\n        mock_committer1.connect.return_value = True\n        mock_committer2.connect.return_value = True\n        mock_committer1.commit_offsets.return_value = {'stockprice': True}\n        mock_committer2.commit_offsets.return_value = {'userdata': True}\n        \n        mock_committer_class.side_effect = [mock_committer1, mock_committer2]\n        \n        committer = MultiConsumerGroupKafkaCommitter(\n            self.bootstrap_servers, \n            self.consumer_group_mapping\n        )\n        committer.connect_all()\n        \n        topic_offsets = {\n            'stockprice': {0: 100, 1: 200},\n            'userdata': {0: 50}\n        }\n        \n        result = committer.commit_offsets(topic_offsets)\n        \n        expected = {\n            'group1': {'stockprice': True},\n            'group2': {'userdata': True}\n        }\n        self.assertEqual(result, expected)\n        \n        # Verify correct offsets were passed to each committer\n        mock_committer1.commit_offsets.assert_called_once_with({'stockprice': {0: 100, 1: 200}})\n        mock_committer2.commit_offsets.assert_called_once_with({'userdata': {0: 50}})\n    \n    @patch('kafka_offset_committer.KafkaOffsetCommitter')\n    def test_get_current_offsets_multiple_groups(self, mock_committer_class):\n        \"\"\"Test getting current offsets from multiple consumer groups.\"\"\"\n        mock_committer1 = Mock()\n        mock_committer2 = Mock()\n        mock_committer1.connect.return_value = True\n        mock_committer2.connect.return_value = True\n        mock_committer1.get_current_offsets.return_value = {'stockprice': {0: 99, 1: 199}}\n        mock_committer2.get_current_offsets.return_value = {'userdata': {0: 49}}\n        \n        mock_committer_class.side_effect = [mock_committer1, mock_committer2]\n        \n        committer = MultiConsumerGroupKafkaCommitter(\n            self.bootstrap_servers, \n            self.consumer_group_mapping\n        )\n        committer.connect_all()\n        \n        result = committer.get_current_offsets(['stockprice', 'userdata'])\n        \n        expected = {\n            'group1': {'stockprice': {0: 99, 1: 199}},\n            'group2': {'userdata': {0: 49}}\n        }\n        self.assertEqual(result, expected)\n    \n    def test_context_manager(self):\n        \"\"\"Test context manager functionality.\"\"\"\n        with patch('kafka_offset_committer.KafkaOffsetCommitter') as mock_committer_class:\n            mock_committer = Mock()\n            mock_committer.connect.return_value = True\n            mock_committer_class.return_value = mock_committer\n            \n            # Test successful context manager usage\n            with MultiConsumerGroupKafkaCommitter(self.bootstrap_servers, self.consumer_group_mapping) as committer:\n                self.assertIsNotNone(committer)\n            \n            # Verify disconnect was called\n            mock_committer.disconnect.assert_called()\n    \n    def test_context_manager_connection_failure(self):\n        \"\"\"Test context manager with connection failure.\"\"\"\n        with patch('kafka_offset_committer.KafkaOffsetCommitter') as mock_committer_class:\n            mock_committer = Mock()\n            mock_committer.connect.return_value = False\n            mock_committer_class.return_value = mock_committer\n            \n            # Test connection failure raises RuntimeError\n            with self.assertRaises(RuntimeError):\n                with MultiConsumerGroupKafkaCommitter(self.bootstrap_servers, self.consumer_group_mapping):\n                    pass\n\n\nif __name__ == '__main__':\n    unittest.main()",
                "command": "create"

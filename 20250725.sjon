                "summary": "Create integration tests for S3 and Kafka connectivity",
                "path": "/Users/zhwenhao/qchatlog/EnhancedSparkConsumerMonitor/test/test_integration.py",
                "file_text": "\"\"\"\nIntegration tests for S3 and Kafka connectivity.\n\nThese tests require actual AWS credentials and Kafka cluster access.\nThey can be run in a test environment to validate end-to-end functionality.\n\"\"\"\n\nimport unittest\nimport os\nimport json\nimport sys\nfrom unittest.mock import patch\n\n# Add plugins to path\nsys.path.append(os.path.join(os.path.dirname(__file__), '..', 'plugins'))\n\nfrom s3_checkpoint_reader import S3CheckpointReader\nfrom kafka_offset_committer import KafkaOffsetCommitter, MultiConsumerGroupKafkaCommitter\nfrom config_manager import ConfigManager\n\n\nclass TestS3Integration(unittest.TestCase):\n    \"\"\"Integration tests for S3 checkpoint reading.\"\"\"\n    \n    @classmethod\n    def setUpClass(cls):\n        \"\"\"Set up class-level test fixtures.\"\"\"\n        cls.test_bucket = os.getenv('TEST_S3_BUCKET', 'test-checkpoint-bucket')\n        cls.test_region = os.getenv('AWS_REGION', 'us-east-1')\n        cls.skip_s3_tests = not os.getenv('RUN_S3_INTEGRATION_TESTS', False)\n    \n    def setUp(self):\n        \"\"\"Set up test fixtures.\"\"\"\n        if self.skip_s3_tests:\n            self.skipTest(\"S3 integration tests disabled. Set RUN_S3_INTEGRATION_TESTS=true to enable.\")\n        \n        self.reader = S3CheckpointReader(aws_region=self.test_region)\n    \n    def test_s3_connection(self):\n        \"\"\"Test basic S3 connection and bucket access.\"\"\"\n        try:\n            # Test parsing a valid S3 path\n            bucket, key = self.reader.parse_s3_path(f's3://{self.test_bucket}/test/path/')\n            self.assertEqual(bucket, self.test_bucket)\n            self.assertEqual(key, 'test/path/')\n            \n            # Test listing objects (even if empty)\n            files = self.reader.list_checkpoint_files(f's3://{self.test_bucket}/nonexistent/')\n            self.assertIsInstance(files, list)\n            \n        except Exception as e:\n            self.fail(f\"S3 connection test failed: {e}\")\n    \n    def test_checkpoint_file_processing(self):\n        \"\"\"Test processing of checkpoint files with mock data.\"\"\"\n        # Create sample checkpoint content\n        sample_content = '''{\"batchWatermarkMs\":0,\"batchTimestampMs\":1752752310004,\"conf\":{\"spark.sql.streaming.stateStore.providerClass\":\"test\"}}\n{\"stockprice\":{\"0\":100,\"1\":200,\"2\":300}}'''\n        \n        try:\n            parsed_data = self.reader.parse_checkpoint_content(sample_content)\n            \n            self.assertIn('metadata', parsed_data)\n            self.assertIn('offsets', parsed_data)\n            self.assertEqual(parsed_data['batch_timestamp'], 1752752310004)\n            self.assertEqual(parsed_data['offsets']['stockprice']['0'], 100)\n            \n            # Test topic offset extraction\n            topic_offsets = self.reader.extract_topic_offsets(parsed_data)\n            expected = {'stockprice': {0: 100, 1: 200, 2: 300}}\n            self.assertEqual(topic_offsets, expected)\n            \n        except Exception as e:\n            self.fail(f\"Checkpoint processing test failed: {e}\")\n\n\nclass TestKafkaIntegration(unittest.TestCase):\n    \"\"\"Integration tests for Kafka connectivity.\"\"\"\n    \n    @classmethod\n    def setUpClass(cls):\n        \"\"\"Set up class-level test fixtures.\"\"\"\n        cls.test_brokers = os.getenv('TEST_KAFKA_BROKERS', 'localhost:9092')\n        cls.test_consumer_group = os.getenv('TEST_CONSUMER_GROUP', 'test-integration-group')\n        cls.skip_kafka_tests = not os.getenv('RUN_KAFKA_INTEGRATION_TESTS', False)\n    \n    def setUp(self):\n        \"\"\"Set up test fixtures.\"\"\"\n        if self.skip_kafka_tests:\n            self.skipTest(\"Kafka integration tests disabled. Set RUN_KAFKA_INTEGRATION_TESTS=true to enable.\")\n    \n    def test_kafka_connection(self):\n        \"\"\"Test basic Kafka connection.\"\"\"\n        committer = KafkaOffsetCommitter(self.test_brokers, self.test_consumer_group)\n        \n        try:\n            result = committer.connect()\n            self.assertTrue(result, \"Failed to connect to Kafka cluster\")\n            \n            # Test disconnection\n            committer.disconnect()\n            \n        except Exception as e:\n            self.fail(f\"Kafka connection test failed: {e}\")\n    \n    def test_topic_validation(self):\n        \"\"\"Test topic validation functionality.\"\"\"\n        committer = KafkaOffsetCommitter(self.test_brokers, self.test_consumer_group)\n        \n        try:\n            if committer.connect():\n                # Test with a mix of existing and non-existing topics\n                test_topics = ['__consumer_offsets', 'nonexistent-topic-12345']\n                validation_result = committer.validate_topics(test_topics)\n                \n                self.assertIsInstance(validation_result, dict)\n                self.assertIn('__consumer_offsets', validation_result)\n                self.assertIn('nonexistent-topic-12345', validation_result)\n                \n                # __consumer_offsets should exist in most Kafka clusters\n                self.assertTrue(validation_result.get('__consumer_offsets', False))\n                \n                committer.disconnect()\n            else:\n                self.skipTest(\"Could not connect to Kafka cluster\")\n                \n        except Exception as e:\n            self.fail(f\"Topic validation test failed: {e}\")\n    \n    def test_multi_consumer_group_connection(self):\n        \"\"\"Test multi-consumer group committer connection.\"\"\"\n        consumer_group_mapping = {\n            'test-topic-1': 'test-group-1',\n            'test-topic-2': 'test-group-2'\n        }\n        \n        multi_committer = MultiConsumerGroupKafkaCommitter(\n            self.test_brokers, \n            consumer_group_mapping\n        )\n        \n        try:\n            connection_results = multi_committer.connect_all()\n            \n            self.assertIsInstance(connection_results, dict)\n            self.assertIn('test-group-1', connection_results)\n            self.assertIn('test-group-2', connection_results)\n            \n            # At least one connection should succeed if Kafka is available\n            success_count = sum(1 for success in connection_results.values() if success)\n            self.assertGreater(success_count, 0, \"No consumer groups could connect to Kafka\")\n            \n            multi_committer.disconnect_all()\n            \n        except Exception as e:\n            self.fail(f\"Multi-consumer group connection test failed: {e}\")\n\n\nclass TestConfigurationIntegration(unittest.TestCase):\n    \"\"\"Integration tests for configuration management.\"\"\"\n    \n    def setUp(self):\n        \"\"\"Set up test fixtures.\"\"\"\n        self.config_manager = ConfigManager()\n    \n    @patch.dict(os.environ, {\n        'AIRFLOW_VAR_MSK_BROKER_STRING': 'test-broker:9092',\n        'AIRFLOW_VAR_S3_CHECKPOINT_PATHS': '[\"s3://test-bucket/path/\"]',\n        'AIRFLOW_VAR_KAFKA_TOPICS': '[\"test-topic\"]'\n    })\n    def test_environment_variable_fallback(self):\n        \"\"\"Test configuration fallback to environment variables.\"\"\"\n        # This test simulates MWAA environment variable behavior\n        with patch('config_manager.Variable.get') as mock_get:\n            # Simulate Airflow Variable not found, should fall back to env vars\n            mock_get.side_effect = Exception(\"Variable not found\")\n            \n            # Test that environment variables are used as fallback\n            # Note: This would require implementing env var fallback in ConfigManager\n            # For now, we test the exception handling\n            with self.assertRaises(Exception):\n                self.config_manager.get_msk_broker_string()\n    \n    def test_configuration_validation_comprehensive(self):\n        \"\"\"Test comprehensive configuration validation.\"\"\"\n        # Mock all required configurations\n        with patch.object(self.config_manager, 'get_msk_broker_string') as mock_brokers, \\\n             patch.object(self.config_manager, 'get_s3_checkpoint_paths') as mock_paths, \\\n             patch.object(self.config_manager, 'get_kafka_topics') as mock_topics, \\\n             patch.object(self.config_manager, 'get_consumer_group_mapping') as mock_mapping, \\\n             patch.object(self.config_manager, 'get_checkpoint_consumer_group_mapping') as mock_checkpoint_mapping:\n            \n            # Setup successful mocks\n            mock_brokers.return_value = \"broker1:9092,broker2:9092\"\n            mock_paths.return_value = [\"s3://test-bucket/checkpoints/\"]\n            mock_topics.return_value = [\"stockprice\", \"userdata\"]\n            mock_mapping.return_value = {\"stockprice\": \"group1\", \"userdata\": \"group2\"}\n            mock_checkpoint_mapping.return_value = {\"s3://test-bucket/checkpoints/\": \"group1\"}\n            \n            validation_result = self.config_manager.validate_configuration()\n            \n            # All validations should pass\n            for key, status in validation_result.items():\n                self.assertTrue(status, f\"Validation failed for {key}\")\n    \n    def test_checkpoint_consumer_group_resolution(self):\n        \"\"\"Test checkpoint-based consumer group resolution.\"\"\"\n        # Mock checkpoint consumer group mapping\n        with patch.object(self.config_manager, 'get_checkpoint_consumer_group_mapping') as mock_mapping:\n            mock_mapping.return_value = {\n                \"s3://bucket/sp1/offsets/\": \"sp1\",\n                \"s3://bucket/sp2/offsets/\": \"sp2\"\n            }\n            \n            # Test data simulating checkpoint data from different sources\n            checkpoint_data = {\n                \"s3://bucket/sp1/offsets/\": {\n                    \"offsets\": {\"stockprice\": {\"0\": 100, \"1\": 200}}\n                },\n                \"s3://bucket/sp2/offsets/\": {\n                    \"offsets\": {\"stockprice\": {\"0\": 150, \"1\": 250}, \"userdata\": {\"0\": 50}}\n                }\n            }\n            \n            result = self.config_manager.resolve_topic_consumer_groups(checkpoint_data)\n            \n            # Verify resolution logic\n            self.assertIn(\"stockprice\", result)\n            self.assertIn(\"userdata\", result)\n            self.assertEqual(result[\"userdata\"], \"sp2\")  # Only sp2 has userdata\n\n\nclass TestEndToEndIntegration(unittest.TestCase):\n    \"\"\"End-to-end integration tests.\"\"\"\n    \n    @classmethod\n    def setUpClass(cls):\n        \"\"\"Set up class-level test fixtures.\"\"\"\n        cls.skip_e2e_tests = not os.getenv('RUN_E2E_INTEGRATION_TESTS', False)\n    \n    def setUp(self):\n        \"\"\"Set up test fixtures.\"\"\"\n        if self.skip_e2e_tests:\n            self.skipTest(\"End-to-end integration tests disabled. Set RUN_E2E_INTEGRATION_TESTS=true to enable.\")\n    \n    def test_complete_workflow_simulation(self):\n        \"\"\"Test complete workflow with mocked external dependencies.\"\"\"\n        # This test simulates the complete DAG workflow without external dependencies\n        \n        # 1. Configuration validation\n        config_manager = ConfigManager()\n        \n        with patch.object(config_manager, 'get_msk_broker_string') as mock_brokers, \\\n             patch.object(config_manager, 'get_s3_checkpoint_paths') as mock_paths, \\\n             patch.object(config_manager, 'get_kafka_topics') as mock_topics:\n            \n            mock_brokers.return_value = \"test-broker:9092\"\n            mock_paths.return_value = [\"s3://test-bucket/checkpoints/\"]\n            mock_topics.return_value = [\"stockprice\"]\n            \n            config = config_manager.get_all_config()\n            self.assertIn('msk_broker_string', config)\n            self.assertIn('s3_checkpoint_paths', config)\n            self.assertIn('kafka_topics', config)\n        \n        # 2. Checkpoint reading simulation\n        reader = S3CheckpointReader()\n        sample_content = '''{\"batchWatermarkMs\":0,\"batchTimestampMs\":1752752310004,\"conf\":{}}\n{\"stockprice\":{\"0\":100,\"1\":200}}'''\n        \n        parsed_data = reader.parse_checkpoint_content(sample_content)\n        topic_offsets = reader.extract_topic_offsets(parsed_data)\n        \n        self.assertEqual(topic_offsets, {'stockprice': {0: 100, 1: 200}})\n        \n        # 3. Consumer group resolution\n        checkpoint_data = {\"s3://test-bucket/checkpoints/\": parsed_data}\n        \n        with patch.object(config_manager, 'get_checkpoint_consumer_group_mapping') as mock_checkpoint_mapping:\n            mock_checkpoint_mapping.return_value = {\"s3://test-bucket/checkpoints/\": \"test-group\"}\n            \n            resolved_mapping = config_manager.resolve_topic_consumer_groups(checkpoint_data)\n            self.assertEqual(resolved_mapping, {'stockprice': 'test-group'})\n        \n        # 4. Offset commit simulation (without actual Kafka)\n        # This would normally connect to Kafka and commit offsets\n        # For integration test, we just verify the data flow\n        \n        self.assertTrue(True, \"End-to-end workflow simulation completed successfully\")\n\n\nif __name__ == '__main__':\n    # Print environment setup instructions\n    print(\"Integration Test Environment Setup:\")\n    print(\"- Set RUN_S3_INTEGRATION_TESTS=true to enable S3 tests\")\n    print(\"- Set RUN_KAFKA_INTEGRATION_TESTS=true to enable Kafka tests\")\n    print(\"- Set RUN_E2E_INTEGRATION_TESTS=true to enable end-to-end tests\")\n    print(\"- Set TEST_S3_BUCKET=your-test-bucket for S3 tests\")\n    print(\"- Set TEST_KAFKA_BROKERS=broker1:9092,broker2:9092 for Kafka tests\")\n    print(\"- Ensure AWS credentials are configured for S3 tests\")\n    print()\n    \n    unittest.main()",
                "command": "create"
              }
            }
          ]
        }
      }

              "$schema": "http://json-schema.org/draft-07/schema#",
              "additionalProperties": false,
              "properties": {
                "opportunity_id": {
                  "type": "string",
                  "description": "The Salesforce Opportunity ID to filter by - this will return all activities/tasks on a opportunity"

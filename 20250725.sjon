      },
      {
        "ToolSpecification": {
          "name": "amzn_mcp___read_internal_website",
          "description": "Read content from internal Amazon websites.\n\nSupported websites and their purposes:\n\nDocumentation & Knowledge:\n- docs.hub.amazon.dev: Internal technical documentation\n- hub.cx.aws.dev: Internal technical documentation for building an experience in the AWS Management Console\n- btdocs.builder-tools.aws.dev: BuilderHub contributor documentation\n- skb.highcastle.a2z: Security knowledge base docs\n- aristotle.a2z.com: AWS Security Knowledge Base Docs\n- docs.aws.amazon.com: External AWS documentation\n- documentation.skynet.aws.dev: Skynet documentation\n- sage.amazon.dev: Engineering Q&A platform\n- datacentral.a2z.com/cradle: DataCentral Cradle job runs\n- oldfart.tools.amazon.dev: Important user tenure information and cohort statistics\n- sidekick.aka.amazon.com: Help users perform redundant tasks of aggregating trouble ticket or SIM data by creating custom oncall reports\n\nDocument Storage & Sharing:\n- workdocs.amazon.com: Amazon WorkDocs (PDFs, Word Docs, Excel)\n- drive-render.corp.amazon.com: Amazon Drive content\n- quip-amazon.com: Collaborative documents\n- paste.amazon.com: Raw content sharing\n- w.amazon.com: Internal MediaWiki\n- apttool.amazon.com: Weblab APT report\n- confluence.collab.games.aws.dev: Amazon Games internal confluence page\n\nDevelopment & Build Tools:\n- code.amazon.com: Internal code repository\n- build.amazon.com: Build fleet and net-gapped builds\n- pipelines.amazon.com: Pipeline information\n- tod.amazon.com: TOD Test run information\n- apollo.amazon.com: Apollo Environment information\n- artifact-browser.brazil.aws.dev: Artifact content browser\n- bindles.amazon.com: Permissions information\n- katal.amazon.dev: UI Components library named Katal (via CloudFront presigned URLs)\n- digicon.amazon.com: Digital Order Console for order information\n- cloudscape.aws.dev: Internal Cloudscape System Design documentation\n\nProject Management & Tickets:\n- taskei.amazon.dev: Task and project management, manage tasks, sprints, kanban boards, planning and scrum processes.\n- t.corp.amazon.com: Ticket system to manage urgent work through severity, routed based on CTI.\n- sim.amazon.com: Legacy issue management system. Used to manage Issues.\n- issues.amazon.com: Legacy issue management system. Used to manage Issues.\n- mcm.amazon.dev: Manual-change-management checklists\n- retro.corp.amazon.com: Sprint retrospectives\n- board.amazon.com: Organize tasks in cards in a board\n- kingpin.amazon.com: Amazon's internal system for managing and reporting goals\n- weblab.amazon.com: Weblab experiment details, configuration settings, and any weblabs flagged as risks.\n\nSecurity & Operations:\n- myappsecdashboard.corp.amazon.com: AppSec affinity contacts\n- cti.amazon.com: CTI and resolver group information\n- design-inspector.a2z.com: Design diagrams and threat models\n- redfort.amazon.com: Public Key Infrastructure for Amazon\n- f2p-visualizer.corp.amazon.com: F2P (Fulfill-to-Promise) visualizer for Amazon order planning information such as https://f2p-visualizer.corp.amazon.com/export/($ORDER_ID)\n\nTeam & Organization:\n- phonetool.amazon.com: Employee roster and details\n\nMedia & Communications:\n- broadcast.amazon.com: Internal broadcasts and videos with transcripts\n\nPolicy Documents:\n- policy.a2z.com: Amazon internal policy documents\nMonitoring\n- monitorportal.amazon.com: iGraph tool\n- carnaval.amazon.com: Monitoring and alarm management\n- deeops.aka.amazon.com: DeeOps STO Health monitoring for user statistics including current over SLA tickets, incoming/open/resolved tickets, MTTR, and ticket age metrics\n- lyrebird.corp.amazon.com: Lyrebird test reports and traffic test details\n\nConcurrency Control:\n- This tool supports processing multiple URLs concurrently with a configurable concurrency limit",
          "input_schema": {
            "json": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "tailingLineCount": {
                  "type": "number",
                  "description": "Number of most recent log lines to return"
                },
                "concurrencyLimit": {
                  "type": "number",
                  "description": "Maximum number of concurrent requests"
                },
                "url": {
                  "format": "uri",
                  "type": "string",
                  "description": "URL of the internal website to read. For backward compatibility with older clients."
                },
                "useGenericStrategy": {
                  "type": "boolean",
                  "default": false,
                  "description": "Use generic HTML to Markdown conversion instead of specific matchers"
                },
                "urls": {
                  "type": "array",
                  "items": {
                    "format": "uri",
                    "type": "string"
                  },
                  "description": "Array of internal website URLs to read. Multiple URLs will be processed concurrently based on the concurrencyLimit parameter."
                }
              },
              "$schema": "http://json-schema.org/draft-07/schema#"
            }
          }
        }
      },
      {
        "ToolSpecification": {
          "name": "amzn_mcp___sim_remove_tag",
          "description": "Remove a tag from an existing SIM issue.\nThe issue ID can be either the P-number (e.g., P12345678) or the alias (e.g., CFN-12345).\nThe assignee should be a valid kerberos username without the @ANT.AMAZON.COM suffix.",
          "input_schema": {
            "json": {
              "type": "object",
              "properties": {
                "tag": {
                  "type": "string",
                  "description": "Tag to remove from the issue"
                },
                "issueId": {
                  "type": "string",
                  "description": "Issue ID or alias (e.g., P12345678 or CFN-12345)"
                }
              },
              "required": [
                "issueId",
                "tag"
              ],
              "additionalProperties": false,
              "$schema": "http://json-schema.org/draft-07/schema#"
            }
          }
        }
      },
      {
        "ToolSpecification": {
          "name": "amzn_mcp___sim_create_issue",
          "description": "Create a new SIM issue.\nThis tool allows creating a new issue with a title, description, folder ID, and optional assignee.\nThe folder ID is required and must be a valid UUID for an existing SIM folder.\nThe assignee should be a valid kerberos username without the @ANT.AMAZON.COM suffix.\nYou MUST display a full url link for the new task. This is the form: https://taskei.amazon.dev/tasks/<id>. Always list this first, before the SIM link.\nYou SHOULD display a url to SIM as well of the form: https://i.amazon.com/issues/<id>.",
          "input_schema": {
            "json": {
              "type": "object",
              "$schema": "http://json-schema.org/draft-07/schema#",
              "additionalProperties": false,
              "properties": {
                "title": {
                  "type": "string",
                  "description": "Title of the issue"
                },
                "folderId": {
                  "type": "string",
                  "description": "Folder UUID where the issue will be created"
                },
                "assignee": {
                  "description": "Optional kerberos username to assign the issue to",
                  "type": "string"
                },
                "description": {
                  "description": "Description of the issue",
                  "type": "string"
                }
              },
              "required": [
                "title",
                "description",
                "folderId"
              ]
            }
          }
        }
      },
      {
        "ToolSpecification": {
          "name": "amzn_mcp___genai_poweruser_get_knowledge_structure",
          "description": "Map the hierarchical organization of your knowledge repository by generating a complete directory structure. This tool provides a navigable overview of how folders and documents are organized, with configurable depth settings to control detail level. Essential for understanding knowledge base architecture and relationships between document collections.",
          "input_schema": {
            "json": {
              "additionalProperties": false,
              "$schema": "http://json-schema.org/draft-07/schema#",
              "type": "object",
              "properties": {

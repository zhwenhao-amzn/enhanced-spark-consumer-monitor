                  "type": "integer",
                  "description": "The index of the first result to return (0-based)",
                  "minimum": 0
                },
                "expand": {
                  "type": "string",
                  "description": "The additional information to include in the response"
                },
                "maxResults": {
                  "type": "integer",
                  "maximum": 1000,
                  "minimum": 1,
                  "description": "The maximum number of results to return (default: 50)"
                },
                "jql": {

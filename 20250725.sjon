                "summary": "Create unit tests for configuration manager",
                "path": "/Users/zhwenhao/qchatlog/EnhancedSparkConsumerMonitor/test/test_config_manager.py",
                "file_text": "\"\"\"\nUnit tests for Configuration Manager module.\n\"\"\"\n\nimport unittest\nfrom unittest.mock import Mock, patch\nimport sys\nimport os\n\n# Add plugins to path\nsys.path.append(os.path.join(os.path.dirname(__file__), '..', 'plugins'))\n\nfrom config_manager import ConfigManager\nfrom airflow.exceptions import AirflowException\n\n\nclass TestConfigManager(unittest.TestCase):\n    \"\"\"Test cases for ConfigManager class.\"\"\"\n    \n    def setUp(self):\n        \"\"\"Set up test fixtures.\"\"\"\n        self.config_manager = ConfigManager()\n        # Clear cache before each test\n        self.config_manager.clear_cache()\n    \n    @patch('config_manager.Variable.get')\n    def test_get_variable_success(self, mock_variable_get):\n        \"\"\"Test successful variable retrieval.\"\"\"\n        mock_variable_get.return_value = \"test_value\"\n        \n        result = self.config_manager.get_variable('test_key')\n        \n        self.assertEqual(result, \"test_value\")\n        mock_variable_get.assert_called_once_with(\n            key='test_key',\n            default_var=None,\n            deserialize_json=False\n        )\n    \n    @patch('config_manager.Variable.get')\n    def test_get_variable_with_default(self, mock_variable_get):\n        \"\"\"Test variable retrieval with default value.\"\"\"\n        mock_variable_get.side_effect = Exception(\"Variable not found\")\n        \n        result = self.config_manager.get_variable('test_key', default_value='default')\n        \n        self.assertEqual(result, 'default')\n    \n    @patch('config_manager.Variable.get')\n    def test_get_variable_missing_required(self, mock_variable_get):\n        \"\"\"Test missing required variable raises exception.\"\"\"\n        mock_variable_get.side_effect = Exception(\"Variable not found\")\n        \n        with self.assertRaises(AirflowException):\n            self.config_manager.get_variable('required_key')\n    \n    @patch('config_manager.Variable.get')\n    def test_get_msk_broker_string_success(self, mock_variable_get):\n        \"\"\"Test successful MSK broker string retrieval.\"\"\"\n        broker_string = \"broker1:9092,broker2:9092\"\n        mock_variable_get.return_value = broker_string\n        \n        result = self.config_manager.get_msk_broker_string()\n        \n        self.assertEqual(result, broker_string)\n    \n    @patch('config_manager.Variable.get')\n    def test_get_msk_broker_string_invalid_format(self, mock_variable_get):\n        \"\"\"Test MSK broker string with invalid format.\"\"\"\n        mock_variable_get.return_value = \"invalid_broker_format\"\n        \n        with self.assertRaises(AirflowException):\n            self.config_manager.get_msk_broker_string()\n    \n    @patch('config_manager.Variable.get')\n    def test_get_s3_checkpoint_paths_json(self, mock_variable_get):\n        \"\"\"Test S3 checkpoint paths retrieval as JSON.\"\"\"\n        paths = [\"s3://bucket1/path1/\", \"s3://bucket2/path2/\"]\n        mock_variable_get.return_value = paths\n        \n        result = self.config_manager.get_s3_checkpoint_paths()\n        \n        self.assertEqual(result, paths)\n    \n    @patch('config_manager.Variable.get')\n    def test_get_s3_checkpoint_paths_string(self, mock_variable_get):\n        \"\"\"Test S3 checkpoint paths retrieval as comma-separated string.\"\"\"\n        # First call (JSON) fails, second call (string) succeeds\n        mock_variable_get.side_effect = [\n            Exception(\"JSON parsing failed\"),\n            \"s3://bucket1/path1/,s3://bucket2/path2/\"\n        ]\n        \n        result = self.config_manager.get_s3_checkpoint_paths()\n        \n        expected = [\"s3://bucket1/path1/\", \"s3://bucket2/path2/\"]\n        self.assertEqual(result, expected)\n    \n    @patch('config_manager.Variable.get')\n    def test_get_s3_checkpoint_paths_invalid_format(self, mock_variable_get):\n        \"\"\"Test S3 checkpoint paths with invalid format.\"\"\"\n        mock_variable_get.side_effect = [\n            Exception(\"JSON parsing failed\"),\n            \"invalid-path,another-invalid-path\"\n        ]\n        \n        with self.assertRaises(AirflowException):\n            self.config_manager.get_s3_checkpoint_paths()\n    \n    @patch('config_manager.Variable.get')\n    def test_get_kafka_topics_json(self, mock_variable_get):\n        \"\"\"Test Kafka topics retrieval as JSON.\"\"\"\n        topics = [\"stockprice\", \"userdata\", \"transactions\"]\n        mock_variable_get.return_value = topics\n        \n        result = self.config_manager.get_kafka_topics()\n        \n        self.assertEqual(result, topics)\n    \n    @patch('config_manager.Variable.get')\n    def test_get_consumer_group_mapping_success(self, mock_variable_get):\n        \"\"\"Test consumer group mapping retrieval.\"\"\"\n        mapping = {\"stockprice\": \"group1\", \"userdata\": \"group2\"}\n        mock_variable_get.return_value = mapping\n        \n        result = self.config_manager.get_consumer_group_mapping()\n        \n        self.assertEqual(result, mapping)\n    \n    @patch('config_manager.Variable.get')\n    def test_get_consumer_group_mapping_fallback(self, mock_variable_get):\n        \"\"\"Test consumer group mapping fallback to default group.\"\"\"\n        # Mock the sequence of calls\n        mock_variable_get.side_effect = [\n            Exception(\"Mapping not found\"),  # kafka_consumer_group_mapping\n            \"default-group\",                 # kafka_consumer_group (fallback)\n            [\"stockprice\", \"userdata\"]       # kafka_topics\n        ]\n        \n        result = self.config_manager.get_consumer_group_mapping()\n        \n        expected = {\"stockprice\": \"default-group\", \"userdata\": \"default-group\"}\n        self.assertEqual(result, expected)\n    \n    @patch('config_manager.Variable.get')\n    def test_get_checkpoint_consumer_group_mapping_success(self, mock_variable_get):\n        \"\"\"Test checkpoint consumer group mapping retrieval.\"\"\"\n        mapping = {\n            \"s3://bucket/sp1/offsets/\": \"sp1\",\n            \"s3://bucket/sp2/offsets/\": \"sp2\"\n        }\n        mock_variable_get.return_value = mapping\n        \n        result = self.config_manager.get_checkpoint_consumer_group_mapping()\n        \n        self.assertEqual(result, mapping)\n    \n    @patch('config_manager.Variable.get')\n    def test_get_checkpoint_consumer_group_mapping_invalid_path(self, mock_variable_get):\n        \"\"\"Test checkpoint consumer group mapping with invalid S3 path.\"\"\"\n        mapping = {\n            \"invalid-path\": \"group1\",\n            \"s3://valid-bucket/path/\": \"group2\"\n        }\n        mock_variable_get.return_value = mapping\n        \n        with self.assertRaises(ValueError):\n            self.config_manager.get_checkpoint_consumer_group_mapping()\n    \n    @patch.object(ConfigManager, 'get_checkpoint_consumer_group_mapping')\n    def test_resolve_topic_consumer_groups(self, mock_get_checkpoint_mapping):\n        \"\"\"Test resolving topic consumer groups from checkpoint data.\"\"\"\n        # Mock checkpoint mapping\n        mock_get_checkpoint_mapping.return_value = {\n            \"s3://bucket/sp1/offsets/\": \"sp1\",\n            \"s3://bucket/sp2/offsets/\": \"sp2\"\n        }\n        \n        # Mock checkpoint data\n        checkpoint_data = {\n            \"s3://bucket/sp1/offsets/\": {\n                \"offsets\": {\"stockprice\": {\"0\": 100, \"1\": 200}}\n            },\n            \"s3://bucket/sp2/offsets/\": {\n                \"offsets\": {\"stockprice\": {\"0\": 150, \"1\": 250}}\n            }\n        }\n        \n        result = self.config_manager.resolve_topic_consumer_groups(checkpoint_data)\n        \n        # Since both checkpoints have the same topic, the last one processed wins\n        expected = {\"stockprice\": \"sp2\"}\n        self.assertEqual(result, expected)\n    \n    @patch.object(ConfigManager, 'get_checkpoint_consumer_group_mapping')\n    def test_resolve_topic_consumer_groups_different_topics(self, mock_get_checkpoint_mapping):\n        \"\"\"Test resolving topic consumer groups with different topics.\"\"\"\n        mock_get_checkpoint_mapping.return_value = {\n            \"s3://bucket/app1/offsets/\": \"app1\",\n            \"s3://bucket/app2/offsets/\": \"app2\"\n        }\n        \n        checkpoint_data = {\n            \"s3://bucket/app1/offsets/\": {\n                \"offsets\": {\"stockprice\": {\"0\": 100}}\n            },\n            \"s3://bucket/app2/offsets/\": {\n                \"offsets\": {\"userdata\": {\"0\": 50}}\n            }\n        }\n        \n        result = self.config_manager.resolve_topic_consumer_groups(checkpoint_data)\n        \n        expected = {\"stockprice\": \"app1\", \"userdata\": \"app2\"}\n        self.assertEqual(result, expected)\n    \n    @patch('config_manager.Variable.get')\n    def test_get_processing_config(self, mock_variable_get):\n        \"\"\"Test processing configuration retrieval.\"\"\"\n        # Mock variable calls for processing config\n        mock_variable_get.side_effect = [\n            \"5\",    # max_retries\n            \"120\",  # retry_delay_seconds\n            \"50\",   # batch_size\n            \"600\"   # timeout_seconds\n        ]\n        \n        result = self.config_manager.get_processing_config()\n        \n        expected = {\n            'max_retries': 5,\n            'retry_delay_seconds': 120,\n            'batch_size': 50,\n            'timeout_seconds': 600\n        }\n        self.assertEqual(result, expected)\n    \n    @patch.object(ConfigManager, 'get_msk_broker_string')\n    @patch.object(ConfigManager, 'get_s3_checkpoint_paths')\n    @patch.object(ConfigManager, 'get_kafka_topics')\n    def test_validate_configuration_success(self, mock_topics, mock_paths, mock_brokers):\n        \"\"\"Test successful configuration validation.\"\"\"\n        mock_brokers.return_value = \"broker1:9092,broker2:9092\"\n        mock_paths.return_value = [\"s3://bucket/path/\"]\n        mock_topics.return_value = [\"stockprice\"]\n        \n        result = self.config_manager.validate_configuration()\n        \n        expected = {\n            'msk_broker_string': True,\n            's3_checkpoint_paths': True,\n            'kafka_topics': True,\n            'consumer_group': True,\n            'aws_region': True,\n            'consumer_group_mapping': True,\n            'checkpoint_consumer_group_mapping': True\n        }\n        \n        # Check that all required validations passed\n        for key in ['msk_broker_string', 's3_checkpoint_paths', 'kafka_topics']:\n            self.assertTrue(result[key])\n    \n    @patch.object(ConfigManager, 'get_msk_broker_string')\n    def test_validate_configuration_failure(self, mock_brokers):\n        \"\"\"Test configuration validation with failures.\"\"\"\n        mock_brokers.side_effect = AirflowException(\"Broker string not found\")\n        \n        result = self.config_manager.validate_configuration()\n        \n        self.assertFalse(result['msk_broker_string'])\n    \n    def test_clear_cache(self):\n        \"\"\"Test cache clearing functionality.\"\"\"\n        # Add something to cache\n        self.config_manager._config_cache['test_key'] = 'test_value'\n        \n        # Clear cache\n        self.config_manager.clear_cache()\n        \n        # Verify cache is empty\n        self.assertEqual(len(self.config_manager._config_cache), 0)\n\n\nif __name__ == '__main__':\n    unittest.main()",
                "command": "create"
